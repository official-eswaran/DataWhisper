# ── DataWhisper backend configuration ─────────────────────────────────────────
# Copy to `.env` and fill in real values. The app REFUSES to start in production
# (DEBUG=false) if SECRET_KEY is unset/default or ALLOWED_ORIGINS is "*".

# Set to false in production. When false, /docs is hidden and security checks are
# enforced (fail-fast on insecure config).
DEBUG=false

# REQUIRED. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Seed account passwords (change before first run; only used to create the
# initial 'ceo' and 'manager' users on an empty database).
ADMIN_PASSWORD=change-me-admin
MANAGER_PASSWORD=change-me-manager

# Account lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENCY=4

# Limits
MAX_UPLOAD_SIZE_MB=500
MAX_RESULT_ROWS=10000
SESSION_TTL_HOURS=24
CONVERSATION_TTL_MINUTES=120

# Rate limits (slowapi syntax: "<count>/<period>")
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_QUERY=30/minute
RATE_LIMIT_UPLOAD=20/minute

# Metadata database (users, orgs, audit, sessions, tokens).
# Empty → SQLite file under DATABASE_DIR (dev/single-node).
# Production multi-node → Postgres, e.g.:
#   postgresql+psycopg://datawhisper:password@postgres:5432/datawhisper
DATABASE_URL=

# Shared state for horizontal scaling. Set this to run WEB_CONCURRENCY>1 or
# multiple replicas — the conversation store and rate limiter then use Redis.
# Leave empty for single-worker in-process state.
REDIS_URL=redis://redis:6379/0

# Observability
LOG_JSON=true             # structured JSON logs for shipping to Loki/ELK/CloudWatch
METRICS_ENABLED=true      # expose Prometheus /metrics

# LLM reliability
LLM_RETRY_ATTEMPTS=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_CIRCUIT_FAIL_THRESHOLD=5
LLM_CIRCUIT_RESET_SECONDS=30

# CORS — explicit origins in production, e.g. https://data.yourcompany.com
# "*" is only accepted when DEBUG=true.
ALLOWED_ORIGINS=https://data.yourcompany.com

# Number of Gunicorn workers. Safe to raise above 1 once REDIS_URL is set
# (the conversation store and rate limiter then share state via Redis).
WEB_CONCURRENCY=2
